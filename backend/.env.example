# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# === Dev profile ===
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# === JWT secret — must be at least 32 characters ===
JWT_SECRET=ReplaceThisWithALongRandomSecretKeyInProduction!@#$

# === Production only ===
DATABASE_URL=jdbc:mysql://localhost:3306/admarket_prod
DATABASE_USERNAME=admarket_user
DATABASE_PASSWORD=strong_production_password

# Local file storage (prod)
UPLOAD_DIR=/var/admarket/uploads
BASE_URL=https://api.admarket.com
