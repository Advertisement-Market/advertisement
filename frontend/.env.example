# Copy to .env and fill in real values. .env is gitignored.

# Base URL of the backend REST API. Defaults to relative ("") so dev/prod reverse proxy works.
VITE_API_URL=


# Google OAuth 2.0 Web client id (from Google Cloud Console). Enables "Continue with Google".
# Leave blank to hide the Google button. Add your dev origin (http://localhost:5173) as an
# Authorized JavaScript origin on the same OAuth client.
VITE_GOOGLE_CLIENT_ID=
