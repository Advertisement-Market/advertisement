# Environment variables for advertisement deployment stack

# Container images (GHCR)
FRONTEND_IMAGE=ghcr.io/advertisement-market/advertisement-frontend:latest
BACKEND_IMAGE=ghcr.io/advertisement-market/advertisement-backend:latest

# Host Ports
FRONTEND_PORT=8086
BACKEND_PORT=8081
ACTUATOR_PORT=8082

# Database Configuration
POSTGRES_DB=adbasket
POSTGRES_USER=adbasket
POSTGRES_PASSWORD=adbasket_secret_pass
# DB_DATA_PATH=/srv/config/app_data/theadbasket/db

# Security & Authentication
JWT_SECRET=change-me-in-production-min-32-chars-please
CORS_ALLOWED_ORIGINS=https://theadbasket.bytepod.in,http://192.168.0.100:8086,http://localhost:8086
# Google OAuth 2.0 Web Client ID (optional - enables Google Sign-in)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=


# Portainer Webhook URL (Get this from Portainer → Stacks → advertisement → Enable Webhook)
PORTAINER_WEBHOOK_URL=https://portainer.bytepod.in/api/stacks/webhooks/<your-webhook-uuid>
